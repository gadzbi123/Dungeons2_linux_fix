+// Wine probes the main image on disk before consulting WINE_DLL_FILE_MAP.
+// Give that probe only the decrypted PE headers; the loader uses the memfd.
+#[cfg(target_os = "linux")]
+fn make_launch_stub(
+    image: &std::fs::File,
+    directory: &Path,
+) -> std::io::Result<tempfile::NamedTempFile> {
+    let invalid = || std::io::Error::new(std::io::ErrorKind::InvalidData, "invalid PE headers");
+    let mut reader = image.try_clone()?;
+    reader.seek(SeekFrom::Start(0))?;
+    let mut dos = [0u8; 64];
+    reader.read_exact(&mut dos)?;
+    if &dos[..2] != b"MZ" {
+        return Err(invalid());
+    }
+    let pe_offset = u32::from_le_bytes(dos[60..64].try_into().unwrap()) as u64;
+    reader.seek(SeekFrom::Start(pe_offset))?;
+    let mut pe = [0u8; 88];
+    reader.read_exact(&mut pe)?;
+    if &pe[..4] != b"PE\0\0" {
+        return Err(invalid());
+    }
+    let header_size = u32::from_le_bytes(pe[84..88].try_into().unwrap()) as u64;
+    let image_size = image.metadata()?.len();
+    if header_size < pe_offset + 88 || header_size > image_size || header_size > 1024 * 1024 {
+        return Err(invalid());
+    }
+    let mut headers = vec![0u8; header_size as usize];
+    reader.seek(SeekFrom::Start(0))?;
+    reader.read_exact(&mut headers)?;
+    let mut stub = tempfile::Builder::new()
+        .prefix(".xodus-launch-")
+        .suffix(".exe")
+        .tempfile_in(directory)?;
+    stub.write_all(&headers)?;
+    stub.as_file().set_len(image_size)?;
+    stub.flush()?;
+    Ok(stub)
+}
