diff --git a/crates/xodus-cli/src/commands/store_token.rs b/crates/xodus-cli/src/commands/store_token.rs
new file mode 100644
index 0000000..25b1516
--- /dev/null
+++ b/crates/xodus-cli/src/commands/store_token.rs
@@ -0,0 +1,48 @@
+use std::io::{Cursor, Read, Write};
+use std::path::Path;
+use std::process::ExitCode;
+use xodus::tokens::TokenManager;
+
+fn field(input: &mut Cursor<Vec<u8>>, max: usize) -> Result<String, ()> {
+    let mut size = [0u8; 4];
+    input.read_exact(&mut size).map_err(|_| ())?;
+    let size = u32::from_le_bytes(size) as usize;
+    if size == 0 || size > max { return Err(()); }
+    let mut text = vec![0; size];
+    input.read_exact(&mut text).map_err(|_| ())?;
+    String::from_utf8(text).map_err(|_| ())
+}
+
+fn parse(data: Vec<u8>) -> Result<(Vec<String>, String), ()> {
+    if data.len() > 8192 { return Err(()); }
+    let mut input = Cursor::new(data);
+    let mut count = [0; 4];
+    input.read_exact(&mut count).map_err(|_| ())?;
+    let count = u32::from_le_bytes(count);
+    if count == 0 || count > 64 { return Err(()); }
+    let mut products = Vec::new();
+    for _ in 0..count {
+        let id = field(&mut input, 32)?;
+        if !id.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'/') { return Err(()); }
+        products.push(id);
+    }
+    let custom = field(&mut input, 4096)?;
+    if input.position() != input.get_ref().len() as u64 { return Err(()); }
+    Ok((products, custom))
+}
+
+pub async fn run(client: &reqwest::Client, tokens: &TokenManager, request: String, output: String) -> ExitCode {
+    let Ok(data) = std::fs::read(request) else { eprintln!("Could not read Store request"); return ExitCode::FAILURE; };
+    let Ok((products, custom)) = parse(data) else { eprintln!("Invalid Store request"); return ExitCode::FAILURE; };
+    let result = crate::license::get_store_license_token(client, tokens, "9P5786PJB9RP".to_owned(), products, custom).await;
+    let Ok(token) = result else { eprintln!("Microsoft license-token request failed"); return ExitCode::FAILURE; };
+    if token.is_empty() { eprintln!("Microsoft returned an empty license token"); return ExitCode::FAILURE; }
+    let output = Path::new(&output);
+    let Some(parent) = output.parent() else { return ExitCode::FAILURE; };
+    let Ok(mut file) = tempfile::NamedTempFile::new_in(parent) else { return ExitCode::FAILURE; };
+    // NamedTempFile creates the file with mode 0600 on Unix. No token is printed.
+    if file.write_all(token.as_bytes()).is_err() || file.as_file().sync_all().is_err() || file.persist(output).is_err() {
+        eprintln!("Could not save the license-token response"); return ExitCode::FAILURE;
+    }
+    ExitCode::SUCCESS
+}
